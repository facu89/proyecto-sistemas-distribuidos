# ESP32 simulado (software/simulador). Copiar como .env (no se sube a git) y completar la clave.
# Se conecta al broker del servidor como cualquier ESP32: TLS mutuo por el puerto público de Funnel.
MQTT_URL=mqtts://bancal.taile538b8.ts.net:443
# Para probar contra el broker local: mqtts://localhost:8883

# El nodoId es también el usuario MQTT y el client ID (tienen que coincidir)
NODO_ID=bancal2esp1
# La clave de MQTT_SIMULADOR_PASSWORD (secrets/.env del broker al que se conecta)
MQTT_PASSWORD=

# CA del broker y certificado de cliente del simulador (los genera software/broker, ver README.md)
MQTT_CA=../broker/security/certs/ca.pem
MQTT_CERT=../broker/security/certs/clientes/bancal2esp1.pem
MQTT_KEY=../broker/security/certs/clientes/bancal2esp1.key

# Dónde guarda la última configuración (lo que en la placa es la memoria NVS)
ESTADO=./estado.json
# Cada cuánto "lee" los sensores (la placa: 5 s)
INTERVALO_MS=5000
