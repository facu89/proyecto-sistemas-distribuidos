# Claves del servicio (software/servicio). Es el ÚNICO archivo de secretos que ve su contenedor: si alguien
# lograra ejecutar código en el servicio (que atiende la web), no vería la clave de root de MySQL, la del
# admin de MQTT ni la cookie de EMQX, que están en .env.
#
# Lo leen también mysql y mysql-actualizar, que crean estos usuarios con estas mismas claves: así cada
# clave está en un solo lugar y no hay dos copias que puedan quedar distintas.

# Usuario MQTT del servicio (lo crea 02-init-users.sh en mqtt_user)
MQTT_SERVICIO_USER=servicio
MQTT_SERVICIO_PASSWORD=clave-del-servicio

# Usuario "servicio" de MySQL: lee el historial y guarda el modo y los rangos de cada bancal (solo
# historial_lecturas y configuracion_nodo). Lo crea o actualiza el contenedor mysql-actualizar en cada "compose up".
MYSQL_SERVICIO_PASSWORD=una-clave-para-el-servicio-en-mysql

# Token del webhook directo de EMQX (/api/webhooks/conexiones). Tiene que ser el mismo que va después de
# "Bearer " en EMQX_CONNECTORS__HTTP__SERVICIO__HEADERS de .env. Vacío: el webhook queda desactivado.
WEBHOOK_TOKEN=poné-acá-algo-largo-y-aleatorio
