# Plantilla de secrets/.env. Copiar la carpeta y completar:
#   cp -r secrets.example secrets
# Lo cargan los dos contenedores con env_file (ver compose.yaml).

# EMQX
EMQX_NODE__NAME=emqx@127.0.0.1
EMQX_NODE__COOKIE=poné-acá-algo-largo-y-aleatorio
EMQX_DASHBOARD__DEFAULT_USERNAME=plantas-admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=una-clave-larga

# MySQL: clave de root y del usuario "emqx" con el que EMQX consulta mqtt_user y mqtt_acl
MYSQL_ROOT_PASSWORD=una-clave-para-root
MYSQL_PASSWORD=una-clave-para-emqx

# Tiene que ser igual a MYSQL_PASSWORD (claves con las que EMQX se conecta a MySQL)
EMQX_AUTHENTICATION__1__PASSWORD=una-clave-para-emqx
EMQX_AUTHORIZATION__SOURCES__1__PASSWORD=una-clave-para-emqx

# Credenciales de clientes MQTT (se insertan automáticamente en MySQL al iniciar la base)
MQTT_ESP_USER=bancal1esp1
MQTT_ESP_PASSWORD=clave-del-esp

MQTT_SERVICIO_USER=servicio
MQTT_SERVICIO_PASSWORD=clave-del-servicio

MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASSWORD=admin123

MQTT_WEB_USER=cliente_web
MQTT_WEB_PASSWORD=clave-cliente-web
