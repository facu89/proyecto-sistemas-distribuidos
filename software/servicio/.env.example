# Configuración opcional del servicio. Copiala como .env (no se sube a git) solo si querés cambiar algo:
#   cp .env.example .env
# El usuario y la clave MQTT (MQTT_SERVICIO_USER / MQTT_SERVICIO_PASSWORD) no van acá: se leen de
# ../broker/secrets/.env, el mismo archivo con el que se cargan en MySQL.
# Los valores de abajo son los que se usan por defecto.

# Broker por TLS. El certificado del broker incluye localhost, emqx, 127.0.0.1 y las IPs que se le pasaron
# a generar_certificados.sh; el nombre de MQTT_URL tiene que ser uno de esos.
MQTT_URL=mqtts://localhost:8883
# CA con la que se verifica el certificado del broker (ruta relativa a esta carpeta)
MQTT_CA=../broker/security/certs/ca.pem

# HTTP: la web (build de Vite) y la API (/api/estado y /api/eventos)
HTTP_PUERTO=8080
# Escuchar solo en esta máquina. Con 0.0.0.0 la web se ve desde otros equipos de la red.
HTTP_HOST=127.0.0.1
WEB_DIST=../../diseño_pagina_web/web/dist

# Reglas
# Riego: se prende con humedad_suelo menor a este valor (%)...
RIEGO_ENCENDER_DEBAJO_DE=20
# ...y se apaga con humedad_suelo mayor o igual a este (%)
RIEGO_APAGAR_DESDE=70
# Ventilador: se prende con temperatura_aire mayor o igual a este valor (°C)...
VENTILADOR_ENCENDER_DESDE=28
# ...y se apaga con temperatura_aire menor a este (°C)
VENTILADOR_APAGAR_DEBAJO_DE=26
