# Configuración opcional del servicio. Copiala como .env (no se sube a git) solo si querés cambiar algo:
#   cp .env.example .env
# Las claves (MQTT_SERVICIO_USER / MQTT_SERVICIO_PASSWORD / MYSQL_SERVICIO_PASSWORD) no van acá: se leen de
# ../broker/secrets/servicio.env, el mismo archivo con el que se crean esos usuarios en MySQL.
# Los valores de abajo son los que se usan por defecto.

# Broker por TLS. El certificado del broker incluye localhost, emqx, 127.0.0.1 y las IPs que se le pasaron
# a generar_certificados.sh; el nombre de MQTT_URL tiene que ser uno de esos.
MQTT_URL=mqtts://localhost:8883
# CA con la que se verifica el certificado del broker (ruta relativa a esta carpeta)
MQTT_CA=../broker/security/certs/ca.pem

# HTTP: la web (build de Vite) y la API (/api/estado y /api/eventos)
HTTP_PUERTO=8080
# Escuchar solo en esta máquina. Con 0.0.0.0 la web se ve desde otros equipos de la red.
HTTP_HOST=127.0.0.1
WEB_DIST=../../diseño_pagina_web/web/dist

# Reglas: valores POR DEFECTO. Cada bancal puede tener los suyos, que se cambian desde la web (panel de
# actuadores) y quedan guardados en MySQL; estos se usan para los bancales que nunca se cambiaron.
# Mínimos: 5 puntos entre prender y apagar el riego, 2 °C entre prender y apagar el cooler.
# Riego: se prende con humedad_suelo menor a este valor (%)...
RIEGO_ENCENDER_DEBAJO_DE=20
# ...y se apaga con humedad_suelo mayor o igual a este (%)
RIEGO_APAGAR_DESDE=70
# Cooler (ventilador): se prende con temperatura_aire mayor o igual a este valor (°C)...
VENTILADOR_ENCENDER_DESDE=28
# ...y se apaga con temperatura_aire menor a este (°C)
VENTILADOR_APAGAR_DEBAJO_DE=26
# Riego por pulsos (lo aplica el ESP32): segundos de bomba en cada riego y lecturas de 5 s de espera después
RIEGO_PULSO_SEGUNDOS=5
RIEGO_ESPERA_LECTURAS=2
# Luz: sin horario, la lámpara prende siempre que esté oscuro. Con horario (hora local, puede cruzar la
# medianoche), prende a oscuras solo dentro de él. Ejemplo: LUZ_HORARIO=18:00-23:00
LUZ_HORARIO=
# Zona horaria del horario de la luz (el servidor corre en UTC)
ZONA_HORARIA=America/Argentina/Buenos_Aires
