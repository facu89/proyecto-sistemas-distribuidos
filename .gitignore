# IDEs                                                                            
.vscode/                                                                          
.idea/                                                                            
*.swp                                                                             
*.DS_Store                                                                        
                                                                                    
# Python (para la parte de software)                                              
__pycache__/                                                                      
*.py[cod]                                                                         
venv/                                                                             
.env
*.log
# Configuración local del firmware (claves de WiFi y MQTT)
firmware/include/config.h

# Secretos del broker (claves y usuarios reales). En git solo va secrets.example/
software/broker/secrets/
!software/broker/secrets.example/.env

# Claves privadas y archivos de la CA (se generan o copian localmente)
software/broker/security/certs/*.key
software/broker/security/certs/key.pem
software/broker/security/certs/*.csr
software/broker/security/certs/*.srl
